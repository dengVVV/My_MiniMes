<Window x:Class="My_MiniMes.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:My_MiniMes.Shell.Views"
        xmlns:vms="clr-namespace:My_MiniMes.Shell.ViewModels"
        Title="My Mini MES" Height="800" Width="1250" WindowStartupLocation="CenterScreen">
    
    <!-- [Prism 对比] 在 Prism 中你会在 ContentControl 里面写 prism:RegionManager.RegionName="MainRegion"。
         而在标准 WPF 中，我们用 DataTemplate 数据模板！
         意思是告诉 WPF：当我在内容区塞入一个 MonitorViewModel 类型的对象时，请自动把它渲染成 views:MonitorView 界面。
         这是 WPF 里最精髓的实现单页应用 (SPA) 架构的方法！-->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vms:MonitorViewModel}">
            <views:MonitorView />
        </DataTemplate>
        <!-- 未来还可以无限增加： <DataTemplate DataType="{x:Type vms:OrderViewModel}"> <views:OrderView /> </DataTemplate> -->
    </Window.Resources>

    <Grid Background="#F0F2F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧菜单 -->
        <Border Grid.Column="0" Background="#12304E" CornerRadius="0 8 8 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Margin="16,18,16,14">
                    <TextBlock Text="Mini MES" Foreground="White" FontSize="24" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,20,10,10">
                    <Button Content="设备监控" Command="{Binding ShowMonitorCommand}" Foreground="White" Background="#1D4F80" BorderThickness="0" Height="42" Margin="0 0 0 10"/>
                    <Button Content="生产订单" Command="{Binding ShowOrderCommand}" Foreground="White" Background="Transparent" BorderThickness="0" Height="42" Margin="0 0 0 10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧主区域 -->
        <Border Grid.Column="1" Background="White" Margin="12" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="#F7FAFD" BorderBrush="#E8EEF5" BorderThickness="0,0,0,1" CornerRadius="12 12 0 0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12 0">
                        <materialDesign:PackIcon Kind="Menu" Width="24" Height="24" Foreground="#1F2D3D" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PageTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#1F2D3D" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 核心魔法：这里绑定了 MainViewModel 里的 CurrentView 变量。
                     只要 ViewModel 里改变了 CurrentView 的值，这里的界面就会根据上面的 DataTemplate 自动切换！ -->
                <ContentControl Grid.Row="1" Margin="8" Content="{Binding CurrentView}" />
            </Grid>
        </Border>
    </Grid>
</Window>

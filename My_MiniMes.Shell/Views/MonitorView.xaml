<UserControl x:Class="My_MiniMes.Shell.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050" Background="#F0F2F5">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 顶部 4 个统计卡片 -->
            <RowDefinition Height="*"/>    <!-- 中间 左设备列表 + 右实时图表 -->
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!-- 1. 顶部统计数据看板                              -->
        <!-- ============================================== -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
            <!-- 运行中 -->
            <Border Margin="0,0,12,0" Padding="16" Background="#E8F5E9" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="#2E7D32" Text="运行中设备" FontSize="13"/>
                    <TextBlock Foreground="#2E7D32" Text="{Binding RunningCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <!-- 断连 -->
            <Border Margin="0,0,12,0" Padding="16" Background="#FFF8E1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="#F57F17" Text="通讯断连" FontSize="13"/>
                    <TextBlock Foreground="#F57F17" Text="{Binding DisconnectedCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <!-- 故障 -->
            <Border Margin="0,0,12,0" Padding="16" Background="#FFEBEE" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="#C62828" Text="故障停机" FontSize="13"/>
                    <TextBlock Foreground="#C62828" Text="{Binding FaultCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <!-- 停用 -->
            <Border Padding="16" Background="#ECEFF1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="#455A64" Text="手动停用" FontSize="13"/>
                    <TextBlock Foreground="#455A64" Text="{Binding DisabledCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============================================== -->
        <!-- 2. 中间主体区域 (分左右两列)                     -->
        <!-- ============================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/> <!-- 左侧设备列表区，固定宽 -->
                <ColumnDefinition Width="*"/>   <!-- 右侧图表区，占据余下所有空间 -->
            </Grid.ColumnDefinitions>

            <!-- =================左侧：设备列表================= -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,12,0">
                <!-- 增加少许阴影使面板有层次感 -->
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.05" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="设备实时列表" FontSize="16" FontWeight="SemiBold" Foreground="#1F2D3D" Margin="4,4,0,12"/>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding DeviceList}" SelectedItem="{Binding SelectedDevice}"
                             Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <!-- 去除 ListBox 自带的烦人蓝色选中框，改用自定义背景色 -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="White" BorderBrush="#E4E7ED" BorderThickness="1" CornerRadius="8" Padding="12">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F5F7FA" />
                                                </Trigger>
                                                <!-- 被选中时的卡片底色变成极浅的蓝色 -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#ECF5FF" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#409EFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 设备图标 -->
                                    <materialDesign:PackIcon Grid.Column="0" Kind="RobotIndustrial" Width="36" Height="36" Foreground="#909399" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    
                                    <!-- 设备名称和IP -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeviceName}" FontSize="15" FontWeight="Bold" Foreground="#303133" />
                                        <TextBlock Text="{Binding IpAddress, StringFormat='{}IP: {0}'}" FontSize="12" Foreground="#909399" Margin="0,4,0,0" />
                                    </StackPanel>
                                    
                                    <!-- 实时状态和小数据 -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Padding="6,2" CornerRadius="4" HorizontalAlignment="Right">
                                            <!-- 根据状态变色 -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F4F4F5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="运行">
                                                            <Setter Property="Background" Value="#F0F9EB" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="断连">
                                                            <Setter Property="Background" Value="#FDF6EC" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="故障">
                                                            <Setter Property="Background" Value="#FEF0F0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DeviceState}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#909399" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DeviceState}" Value="运行">
                                                                <Setter Property="Foreground" Value="#67C23A" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DeviceState}" Value="断连">
                                                                <Setter Property="Foreground" Value="#E6A23C" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DeviceState}" Value="故障">
                                                                <Setter Property="Foreground" Value="#F56C6C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        
                                        <!-- 温度简报，如果没温度就不显示 -->
                                        <TextBlock Text="{Binding Temperature, StringFormat='{}{0:F1} ℃'}" FontSize="13" Foreground="#1F2D3D" FontWeight="SemiBold" 
                                                   HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- =================右侧：深色图表区================= -->
            <Border Grid.Column="1" Background="#1C2128" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.1" />
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 图表区标题栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="实时监控面板 - " FontSize="18" Foreground="White" FontWeight="SemiBold"/>
                        <!-- 动态显示当前选中的设备，没有选中时提示 -->
                        <TextBlock FontSize="18" Foreground="#3b82f6" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding SelectedDevice.DeviceName}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                            <Setter Property="Text" Value="请选择左侧设备" />
                                            <Setter Property="Foreground" Value="#6B7280" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- 动态状态详情展示条 -->
                    <Border Grid.Row="1" Background="#22272E" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- 温度 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="当前核心温度" Foreground="#ADBAC7" FontSize="13" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedDevice.Temperature, StringFormat='{}{0:F1}'}" Foreground="#3b82f6" FontSize="26" FontWeight="Bold" />
                                    <TextBlock Text="℃" Foreground="#ADBAC7" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 压力 -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="液压管网压力" Foreground="#ADBAC7" FontSize="13" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedDevice.Pressure, StringFormat='{}{0:F1}'}" Foreground="#f97316" FontSize="26" FontWeight="Bold" />
                                    <TextBlock Text="Bar" Foreground="#ADBAC7" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 端口号 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="通讯端口" Foreground="#ADBAC7" FontSize="13" />
                                <TextBlock Text="{Binding SelectedDevice.Port}" Foreground="#2ea043" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- LiveCharts2 组件 -->
                    <!-- 极其干净、专业的折线图面板 -->
                    <lvc:CartesianChart Grid.Row="2"
                                        Series="{Binding ChartSeries}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        TooltipPosition="Right"
                                        LegendPosition="Top">
                    </lvc:CartesianChart>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

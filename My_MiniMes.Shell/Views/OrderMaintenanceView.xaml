<UserControl x:Class="My_MiniMes.Shell.Views.OrderMaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1050" Background="#F0F2F5">

    <UserControl.Resources>
        <Style x:Key="OrderIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconForegroundButton}">
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部操作栏：新增、编辑、删除、刷新 -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.05" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="订单维护" FontSize="16" FontWeight="SemiBold" Foreground="#1F2D3D" VerticalAlignment="Center" />

                <Button Grid.Column="1" Style="{StaticResource OrderIconButtonStyle}" Width="36" Height="36" Padding="0"
                        Command="{Binding AddOrderCommand}" ToolTip="新增订单" Foreground="#409EFF" Margin="0,0,4,0">
                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" />
                </Button>

                <Button Grid.Column="2" Style="{StaticResource OrderIconButtonStyle}" Width="36" Height="36" Padding="0"
                        Command="{Binding EditOrderCommand}" ToolTip="编辑订单" Foreground="#E6A23C" Margin="0,0,4,0">
                    <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" />
                </Button>

                <Button Grid.Column="3" Style="{StaticResource OrderIconButtonStyle}" Width="36" Height="36" Padding="0"
                        Command="{Binding DeleteOrderCommand}" ToolTip="删除订单" Foreground="#F56C6C" Margin="0,0,4,0">
                    <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" />
                </Button>

                <Button Grid.Column="4" Style="{StaticResource OrderIconButtonStyle}" Width="36" Height="36" Padding="0"
                        Command="{Binding RefreshCommand}" ToolTip="刷新" Foreground="#909399">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                </Button>
            </Grid>
        </Border>

        <!-- 下方订单表格 -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.05" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 调度工具栏：选择设备和执行调度/完成 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="调度设备:" FontSize="14" Foreground="#606266" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableDevices}"
                              DisplayMemberPath="DeviceName"
                              SelectedItem="{Binding SelectedDispatchDevice}"
                              Background="White" Foreground="#303133" Padding="8,6">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#303133" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <Button Grid.Column="2" Style="{StaticResource OrderIconButtonStyle}" Width="36" Height="36" Padding="0"
                            Command="{Binding DispatchSelectedCommand}" ToolTip="调度到设备" Foreground="#409EFF" Margin="8,0,4,0">
                        <materialDesign:PackIcon Kind="PlayArrow" Width="20" Height="20" />
                    </Button>

                    <Button Grid.Column="3" Style="{StaticResource OrderIconButtonStyle}" Width="36" Height="36" Padding="0"
                            Command="{Binding CompleteSelectedCommand}" ToolTip="完成订单" Foreground="#67C23A">
                        <materialDesign:PackIcon Kind="Check" Width="20" Height="20" />
                    </Button>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFBFC"
                          BorderBrush="#E4E7ED"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF1F5"
                          RowHeight="44">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F5F7FA" />
                            <Setter Property="Foreground" Value="#606266" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="BorderBrush" Value="#E4E7ED" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="#303133" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="10,0" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="Foreground" Value="#303133" />
                            <Setter Property="BorderBrush" Value="#EEF1F5" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#ECF5FF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="订单号" Binding="{Binding OrderNo}" Width="170" />
                        <DataGridTextColumn Header="产品名称" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="客户名称" Binding="{Binding CustomerName}" Width="*" />
                        <DataGridTextColumn Header="目标数量" Binding="{Binding TargetQuantity, StringFormat={}{0:N0}}" Width="100" />
                        <DataGridTextColumn Header="已生产" Binding="{Binding ProducedQuantity, StringFormat={}{0:N0}}" Width="100" />

                        <DataGridTemplateColumn Header="进度" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#606266" />
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="6" Margin="0,4,0,0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Background" Value="#E4E7ED" />
                                                    <Setter Property="Foreground" Value="#409EFF" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="1">
                                                            <Setter Property="Foreground" Value="#67C23A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="2">
                                                            <Setter Property="Foreground" Value="#2E7D32" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="状态" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,2" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#ECF5FF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="1">
                                                        <Setter Property="Background" Value="#F0F9EB" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="2">
                                                        <Setter Property="Background" Value="#ECEFF1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#409EFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="1">
                                                            <Setter Property="Foreground" Value="#67C23A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="2">
                                                            <Setter Property="Foreground" Value="#909399" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="调度设备" Binding="{Binding DeviceDisplay}" Width="120" />
                        <DataGridTextColumn Header="交付期限" Binding="{Binding DeadlineText}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="My_MiniMes.Shell.Views.OrderBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1050" Background="#F0F2F5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="OrderIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconForegroundButton}">
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部四项订单统计卡片，风格与设备监控页保持一致 -->
        <UniformGrid Grid.Row="0" Columns="4">
            <Border Margin="0,0,12,0" Padding="16" Background="#E8F5E9" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="生产中订单" Foreground="#2E7D32" FontSize="13" />
                    <TextBlock Text="{Binding InProgressCount}" Foreground="#2E7D32" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,12,0" Padding="16" Background="#FFF8E1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="待生产订单" Foreground="#F57F17" FontSize="13" />
                    <TextBlock Text="{Binding PendingCount}" Foreground="#F57F17" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,12,0" Padding="16" Background="#E3F2FD" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="已完成订单" Foreground="#1976D2" FontSize="13" />
                    <TextBlock Text="{Binding CompletedCount}" Foreground="#1976D2" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Padding="16" Background="#FFEBEE" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="逾期订单" Foreground="#C62828" FontSize="13" />
                    <TextBlock Text="{Binding OverdueCount}" Foreground="#C62828" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 下方订单执行列表 -->
        <Border Grid.Row="1" Margin="0,12,0,0" Background="White" CornerRadius="8" Padding="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.05" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 工具栏：设备选择、调度、完成、刷新 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="订单执行列表" FontSize="16" FontWeight="SemiBold" Foreground="#1F2D3D" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="分类:" FontSize="14" Foreground="#606266" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <ComboBox Grid.Column="2" Width="180" Margin="0,0,12,0"
                              ItemsSource="{Binding DeviceFilterOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedDeviceFilter}"
                              Background="White" Foreground="#303133" Padding="8,6">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#303133" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <ComboBox Grid.Column="3" Width="200" Margin="0,0,8,0"
                              ItemsSource="{Binding AvailableDevices}"
                              DisplayMemberPath="DeviceName"
                              SelectedItem="{Binding SelectedDispatchDevice}"
                              Background="White" Foreground="#303133" Padding="8,6">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#303133" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <Button Grid.Column="4" Style="{StaticResource OrderIconButtonStyle}" Width="36" Height="36" Padding="0"
                            Command="{Binding DispatchSelectedCommand}" ToolTip="调度到设备" Foreground="#409EFF" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="PlayArrow" Width="20" Height="20" />
                    </Button>

                    <Button Grid.Column="5" Style="{StaticResource OrderIconButtonStyle}" Width="36" Height="36" Padding="0"
                            Command="{Binding CompleteSelectedCommand}" ToolTip="完成订单" Foreground="#67C23A" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="Check" Width="20" Height="20" />
                    </Button>

                    <Button Grid.Column="6" Style="{StaticResource OrderIconButtonStyle}" Width="36" Height="36" Padding="0"
                            Command="{Binding RefreshCommand}" ToolTip="刷新" Foreground="#909399">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                    </Button>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                         Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.ScrollChanged="OrdersScrollViewer_ScrollChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="#F8FAFC" BorderBrush="#E4E7ED" BorderThickness="1" CornerRadius="8" Padding="14">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F5F7FA" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#ECF5FF" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#409EFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 左侧：订单号、产品、客户 -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding OrderNo}" FontSize="15" FontWeight="Bold" Foreground="#303133" VerticalAlignment="Center" />

                                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ECF5FF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="1">
                                                            <Setter Property="Background" Value="#F0F9EB" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="2">
                                                            <Setter Property="Background" Value="#ECEFF1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#409EFF" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="1">
                                                                <Setter Property="Foreground" Value="#67C23A" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="2">
                                                                <Setter Property="Foreground" Value="#909399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="4" Background="#FFEBEE"
                                                Visibility="{Binding IsOverdue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="已逾期" Foreground="#C62828" FontSize="12" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ProductName}" FontSize="14" FontWeight="SemiBold" Foreground="#1F2D3D" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding CustomerName, StringFormat='{}客户: {0}'}" FontSize="13" Foreground="#909399" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- 右侧：生产进度、设备、交付期限 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="14" FontWeight="SemiBold" Foreground="#303133" />
                                        <TextBlock Grid.Column="1" Text="{Binding DeviceDisplay}" FontSize="13" Foreground="#606266" />
                                    </Grid>

                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Margin="0,6,0,0">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Height" Value="8" />
                                                <Setter Property="Background" Value="#E4E7ED" />
                                                <Setter Property="Foreground" Value="#409EFF" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="1">
                                                        <Setter Property="Foreground" Value="#67C23A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="2">
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>

                                    <TextBlock Text="{Binding DeadlineText, StringFormat='{}交付: {0}'}" FontSize="12" Foreground="#909399" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>

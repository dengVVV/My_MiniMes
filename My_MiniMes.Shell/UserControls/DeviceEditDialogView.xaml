<UserControl x:Class="My_MiniMes.Shell.UserControls.DeviceEditDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="550" Padding="24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="配置下位机 (Device Config)" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBox materialDesign:HintAssist.Hint="设备名称 (Device Name)" 
                     Text="{Binding EditingDevice.DeviceName}" 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="IP 地址 (针对网口 TCP)" 
                         Text="{Binding EditingDevice.IpAddress}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="端口号 (Port)" 
                         Text="{Binding EditingDevice.Port}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="串口号 (如 COM1，针对串口 RTU)" 
                         Text="{Binding EditingDevice.SerialPort}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="从站ID (Slave ID)" 
                         Text="{Binding EditingDevice.SlaveId}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </Grid>

            <GroupBox Header="高级串口参数 (仅串口 RTU 模式生效)" Style="{StaticResource MaterialDesignGroupBox}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" materialDesign:HintAssist.Hint="波特率 (默认 9600)" 
                             Text="{Binding EditingDevice.BaudRate}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,8,0,12"/>
                    
                    <TextBox Grid.Row="0" Grid.Column="2" materialDesign:HintAssist.Hint="数据位 (默认 8)" 
                             Text="{Binding EditingDevice.DataBits}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,8,0,12"/>

                    <TextBox Grid.Row="1" Grid.Column="0" materialDesign:HintAssist.Hint="停止位 (1=One, 2=Two)" 
                             Text="{Binding EditingDevice.StopBits}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>

                    <TextBox Grid.Row="1" Grid.Column="2" materialDesign:HintAssist.Hint="校验位 (0=None, 1=Odd, 2=Even)" 
                             Text="{Binding EditingDevice.Parity}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                </Grid>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" 
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0"/>
            <Button Content="保存" IsDefault="True" Command="{Binding SaveDeviceCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
